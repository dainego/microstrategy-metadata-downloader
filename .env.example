# URL base de la API REST de MicroStrategy.
MSTR_BASE_URL=https://bi.movistar.com.ar/MicroStrategyLibrary/api

# Credenciales utilizadas para iniciar sesión en MicroStrategy.
MSTR_USERNAME=your_username
MSTR_PASSWORD=your_password

# Nombre de la aplicación utilizado para identificar los logs.
APP_NAME=microstrategy-metadata-downloader

# Códigos de los tipos de objetos que permite descargar el programa.
OBJECT_TYPE_ATTRIBUTE=12
OBJECT_TYPE_METRIC=4
OBJECT_TYPE_FILTER=1
OBJECT_TYPE_FACT=13

# Proyecto 1: identificador del proyecto en MicroStrategy.
MSTR_PROJECT_1_ID=86B8BBB711E8A19F0A290080EF251385
MSTR_PROJECT_1_NAME=BigData

# Proyecto 1: identificadores de las carpetas raíz de cada búsqueda.
MSTR_PROJECT_1_ATTRIBUTE_ROOT=6F55FB47F9974EABA18CB0C5FF46785C
MSTR_PROJECT_1_METRIC_ROOT=E0CCB9CF22104A489CBE78D974AFD19E
MSTR_PROJECT_1_FILTER_ROOT=CA2E76087685440FBB15F6374E9A3968
MSTR_PROJECT_1_FACT_ROOT=D4BB03B950C14CB0946D64FFC136FEF5

# Proyecto 2: identificador del proyecto en MicroStrategy.
MSTR_PROJECT_2_ID=project_2_id
MSTR_PROJECT_2_NAME=MUC

# Proyecto 2: identificadores de las carpetas raíz de cada búsqueda.
MSTR_PROJECT_2_ATTRIBUTE_ROOT=project_2_attribute_root_id
MSTR_PROJECT_2_METRIC_ROOT=project_2_metric_root_id
MSTR_PROJECT_2_FILTER_ROOT=project_2_filter_root_id
MSTR_PROJECT_2_FACT_ROOT=project_2_fact_root_id